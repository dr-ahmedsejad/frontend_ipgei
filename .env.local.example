# Copier en `.env.local` et ajuster. NE PAS committer `.env.local` (ignoré via .gitignore).

# URL du backend Django (DRF)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Bypass dev : auto-login admin sans mot de passe.
# ⚠️ JAMAIS en prod / staging — laisser `false` ou non défini.
# N'a d'effet que si NODE_ENV !== 'production' (garde tree-shake côté lib/dev-mode.ts).
NEXT_PUBLIC_DEV_BYPASS=false
